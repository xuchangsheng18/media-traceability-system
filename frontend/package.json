{
  "name": "media-trace-poc-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "test": "vitest run",
    "generate:contracts": "openapi-typescript ../docs/03-api/openapi.yaml -o ../shared-contracts/generated/business-api.d.ts && openapi-typescript ../docs/03-api/inference-openapi.yaml -o ../shared-contracts/generated/inference-api.d.ts && node ../scripts/generate-event-types.mjs",
    "lint": "eslint src e2e e2e-live *.ts *.mjs --max-warnings=0",
    "format-check": "prettier --check \"src/**/*.{ts,vue,css}\" \"e2e/**/*.ts\" \"e2e-live/**/*.mjs\" \"*.{ts,mjs,json,html}\"",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\" \"e2e/**/*.ts\" \"e2e-live/**/*.mjs\" \"*.{ts,mjs,json,html}\"",
    "type-check": "vue-tsc --noEmit",
    "test:foundation-browser": "playwright test --config=foundation-playwright.config.ts"
  },
  "dependencies": {
    "vue": "3.5.43",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "22.20.5",
    "@vitejs/plugin-vue": "6.0.10",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.11.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.13"
  }
}
