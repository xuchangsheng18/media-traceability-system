{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:media-trace:dataset:D06:annotation:0.1.0",
  "type": "object",
  "properties": {
    "sample_id": {
      "type": "string",
      "format": "uuid"
    },
    "dataset_id": {
      "const": "D06"
    },
    "asset_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "source_group_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "source_authorization_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "annotation_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "annotation_status": {
      "type": "string",
      "enum": [
        "draft",
        "reviewed",
        "disputed",
        "unknown"
      ]
    },
    "reviewer_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "quality_tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "payload": {
      "type": "object",
      "properties": {
        "original_asset_id": {
          "type": "string",
          "format": "uuid"
        },
        "edited_asset_id": {
          "type": "string",
          "format": "uuid"
        },
        "mask_ref": {
          "anyOf": [
            {
              "$ref": "urn:media-trace:api:0.1.0#/$defs/ObjectRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "tamper_type": {
          "type": "string",
          "enum": [
            "splice",
            "copy_move",
            "erase",
            "replace",
            "local_generation",
            "none",
            "unknown"
          ]
        },
        "editing_operations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "minItems": 0
        },
        "parameters_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "original_asset_id",
        "edited_asset_id",
        "mask_ref",
        "tamper_type",
        "editing_operations",
        "parameters_sha256"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "sample_id",
    "dataset_id",
    "asset_ids",
    "source_group_ids",
    "source_authorization_ref",
    "annotation_version",
    "annotation_status",
    "reviewer_refs",
    "quality_tags",
    "payload"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "annotation_status": {
            "const": "reviewed"
          }
        }
      },
      "then": {
        "properties": {
          "reviewer_refs": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
