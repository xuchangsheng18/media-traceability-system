{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:media-trace:dataset:D13:annotation:0.1.0",
  "type": "object",
  "properties": {
    "sample_id": {
      "type": "string",
      "format": "uuid"
    },
    "dataset_id": {
      "const": "D13"
    },
    "asset_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "source_group_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "source_authorization_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "annotation_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "annotation_status": {
      "type": "string",
      "enum": [
        "draft",
        "reviewed",
        "disputed",
        "unknown"
      ]
    },
    "reviewer_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "quality_tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "payload": {
      "type": "object",
      "properties": {
        "claim": {
          "type": "object",
          "properties": {
            "subject": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                {
                  "type": "null"
                }
              ]
            },
            "action": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                {
                  "type": "null"
                }
              ]
            },
            "time": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                {
                  "type": "null"
                }
              ]
            },
            "place": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                {
                  "type": "null"
                }
              ]
            },
            "result": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                {
                  "type": "null"
                }
              ]
            },
            "source_segment_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid"
              },
              "minItems": 1
            }
          },
          "required": [
            "subject",
            "action",
            "time",
            "place",
            "result",
            "source_segment_ids"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "claim"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "sample_id",
    "dataset_id",
    "asset_ids",
    "source_group_ids",
    "source_authorization_ref",
    "annotation_version",
    "annotation_status",
    "reviewer_refs",
    "quality_tags",
    "payload"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "annotation_status": {
            "const": "reviewed"
          }
        }
      },
      "then": {
        "properties": {
          "reviewer_refs": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
