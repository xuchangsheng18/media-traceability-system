{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:media-trace:stage-one:dag:0.1.0",
  "type": "object",
  "properties": {
    "dag_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "dag_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "status": {
      "const": "ENGINEERING_CANDIDATE"
    },
    "requirement_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "source_task_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "external_inputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "node_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "kind": {
            "enum": [
              "media",
              "model",
              "projection",
              "publish",
              "control",
              "response"
            ]
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "required": {
            "type": "boolean"
          },
          "model_id": {
            "anyOf": [
              {
                "enum": [
                  "M01",
                  "M02",
                  "M03",
                  "M04",
                  "M05",
                  "M06",
                  "M07",
                  "M08",
                  "M09",
                  "M10",
                  "M11",
                  "M12",
                  "M13",
                  "M14",
                  "M15",
                  "M16",
                  "M17",
                  "M18",
                  "M19",
                  "M20",
                  "M21",
                  "M22",
                  "M23",
                  "M24",
                  "M25",
                  "M26",
                  "M27",
                  "M28",
                  "M29",
                  "M30",
                  "M31",
                  "M32",
                  "M33",
                  "M34"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "request_schema_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              {
                "type": "null"
              }
            ]
          },
          "response_schema_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              {
                "type": "null"
              }
            ]
          },
          "input_bindings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field_path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "source": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                }
              },
              "required": [
                "field_path",
                "source"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "minItems": 1
          },
          "missing_policy": {
            "enum": [
              "FAIL_REQUIRED",
              "SKIP_OPTIONAL_WITH_REASON"
            ]
          },
          "active_entry_modes": {
            "type": "array",
            "items": {
              "enum": [
                "ANALYSIS_ASYNC",
                "MODEL_SYNC",
                "CONTROL_TRANSACTION",
                "READ_ONLY"
              ]
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "node_id",
          "kind",
          "dependencies",
          "required",
          "model_id",
          "request_schema_id",
          "response_schema_id",
          "input_bindings",
          "outputs",
          "missing_policy",
          "active_entry_modes"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "entry_variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "operation_id": {
            "type": "string",
            "minLength": 1
          },
          "mode": {
            "enum": [
              "ANALYSIS_ASYNC",
              "MODEL_SYNC",
              "CONTROL_TRANSACTION",
              "READ_ONLY"
            ]
          },
          "request_structure_source": {
            "type": [
              "string",
              "null"
            ]
          },
          "internal_run_record_required": {
            "type": "boolean"
          }
        },
        "required": [
          "operation_id",
          "mode",
          "request_structure_source",
          "internal_run_record_required"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "dag_id",
    "dag_version",
    "status",
    "requirement_id",
    "source_task_ids",
    "external_inputs",
    "nodes",
    "entry_variants"
  ],
  "additionalProperties": false
}
