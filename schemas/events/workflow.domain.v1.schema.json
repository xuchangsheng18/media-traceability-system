{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:media-trace:stage-one:domain-event:0.1.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "event_type": {
      "enum": [
        "workflow.run.accepted.v1",
        "workflow.node.completed.v1",
        "workflow.node.failed.v1",
        "workflow.run.cancel_requested.v1",
        "workflow.run.cancelled.v1",
        "workflow.result.published.v1",
        "workflow.review.returned.v1"
      ]
    },
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "producer_role": {
      "enum": [
        "scheduler",
        "worker",
        "review_service"
      ]
    },
    "binding": {
      "type": "object",
      "properties": {
        "org_id": {
          "type": "string",
          "format": "uuid"
        },
        "case_id": {
          "type": "string",
          "format": "uuid"
        },
        "task_id": {
          "type": "string",
          "format": "uuid"
        },
        "run_version": {
          "type": "integer",
          "minimum": 1
        },
        "result_version": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "policy_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "dag_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "org_id",
        "case_id",
        "task_id",
        "run_version",
        "result_version",
        "policy_version",
        "dag_version"
      ],
      "additionalProperties": false
    },
    "node_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        {
          "type": "null"
        }
      ]
    },
    "attempt": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "fencing_epoch": {
      "type": "integer",
      "minimum": 1
    },
    "state": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "result_snapshot_ref": {
      "anyOf": [
        {
          "$ref": "urn:media-trace:api:0.1.0#/$defs/ObjectRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "reason": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "event_type",
    "event_id",
    "occurred_at",
    "request_id",
    "producer_role",
    "binding",
    "node_id",
    "attempt",
    "fencing_epoch",
    "state",
    "result_snapshot_ref",
    "reason"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "workflow.result.published.v1"
          }
        }
      },
      "then": {
        "properties": {
          "result_snapshot_ref": {
            "$ref": "urn:media-trace:api:0.1.0#/$defs/ObjectRef"
          },
          "binding": {
            "properties": {
              "result_version": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "enum": [
              "workflow.node.completed.v1",
              "workflow.node.failed.v1"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "node_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "attempt": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "enum": [
              "workflow.node.failed.v1",
              "workflow.review.returned.v1"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "workflow.run.accepted.v1"
          }
        }
      },
      "then": {
        "properties": {
          "state": {
            "const": "QUEUED"
          },
          "producer_role": {
            "const": "scheduler"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "workflow.node.completed.v1"
          }
        }
      },
      "then": {
        "properties": {
          "state": {
            "const": "SUCCEEDED"
          },
          "producer_role": {
            "const": "worker"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "workflow.node.failed.v1"
          }
        }
      },
      "then": {
        "properties": {
          "state": {
            "const": "FAILED"
          },
          "producer_role": {
            "const": "worker"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "workflow.run.cancel_requested.v1"
          }
        }
      },
      "then": {
        "properties": {
          "state": {
            "const": "CANCEL_REQUESTED"
          },
          "producer_role": {
            "const": "scheduler"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "workflow.run.cancelled.v1"
          }
        }
      },
      "then": {
        "properties": {
          "state": {
            "const": "CANCELLED"
          },
          "producer_role": {
            "const": "scheduler"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "workflow.result.published.v1"
          }
        }
      },
      "then": {
        "properties": {
          "state": {
            "const": "PUBLISHED"
          },
          "producer_role": {
            "const": "scheduler"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "workflow.review.returned.v1"
          }
        }
      },
      "then": {
        "properties": {
          "state": {
            "const": "RETURNED"
          },
          "producer_role": {
            "const": "review_service"
          }
        }
      }
    }
  ]
}
