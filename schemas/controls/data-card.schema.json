{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:media-trace:stage-one:data-card:0.1.0",
  "type": "object",
  "properties": {
    "dataset_id": {
      "enum": [
        "D01",
        "D02",
        "D03",
        "D04",
        "D05",
        "D06",
        "D07",
        "D08",
        "D09",
        "D10",
        "D11",
        "D12",
        "D13",
        "D14",
        "D15"
      ]
    },
    "catalog_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "catalog_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_authorization_record_ref": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        {
          "type": "null"
        }
      ]
    },
    "authorized_manifest_ref": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        {
          "type": "null"
        }
      ]
    },
    "authorization_status": {
      "enum": [
        "pending",
        "verified",
        "expired",
        "revoked"
      ]
    },
    "counts": {
      "type": "object",
      "properties": {
        "original_assets": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "derived_assets": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "samples": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "annotations": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "content_clusters": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "independent_source_groups": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "train": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "validation": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "calibration": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "sealed_test": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "original_assets",
        "derived_assets",
        "samples",
        "annotations",
        "content_clusters",
        "independent_source_groups",
        "train",
        "validation",
        "calibration",
        "sealed_test"
      ],
      "additionalProperties": false
    },
    "label_version": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        {
          "type": "null"
        }
      ]
    },
    "quality_protocol_ref": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        {
          "type": "null"
        }
      ]
    },
    "quality_passed_count": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "split_manifest_ref": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        {
          "type": "null"
        }
      ]
    },
    "source_group_rules": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    },
    "owner_name": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        {
          "type": "null"
        }
      ]
    },
    "actual_release_date": {
      "anyOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "null"
        }
      ]
    },
    "observation_status": {
      "enum": [
        "NO_AUTHORIZED_REAL_MANIFEST_PROVIDED",
        "AUTHORIZED_METADATA_OBSERVED"
      ]
    }
  },
  "required": [
    "dataset_id",
    "catalog_ref",
    "catalog_sha256",
    "source_authorization_record_ref",
    "authorized_manifest_ref",
    "authorization_status",
    "counts",
    "label_version",
    "quality_protocol_ref",
    "quality_passed_count",
    "split_manifest_ref",
    "source_group_rules",
    "owner_name",
    "actual_release_date",
    "observation_status"
  ],
  "additionalProperties": false
}
