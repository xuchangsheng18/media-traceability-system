{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:media-trace:security:access-control-model:0.1.0",
  "title": "T011 candidate access control design",
  "type": "object",
  "additionalProperties": false,
  "required": ["revision", "status", "production_enabled", "formal_approved", "default_effect", "sources", "entities", "classification", "permissions", "case_review_permissions", "roles", "operations"],
  "properties": {
    "revision": {"type": "string", "minLength": 1},
    "status": {"const": "CANDIDATE_DESIGN_REVIEW_ONLY"},
    "production_enabled": {"const": false},
    "formal_approved": {"const": false},
    "default_effect": {"const": "DENY"},
    "sources": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "entities": {
      "type": "array", "minItems": 8, "uniqueItems": true,
      "items": {"type": "string", "enum": ["organizations", "users", "roles", "permissions", "user_roles", "role_permissions", "cases", "case_membership"]}
    },
    "classification": {
      "type": "object", "additionalProperties": false,
      "required": ["formal_policy_ref", "formal_levels", "storage_status", "review_semantics"],
      "properties": {
        "formal_policy_ref": {"type": "null"},
        "formal_levels": {"type": "array", "maxItems": 0},
        "storage_status": {"const": "DESIGN_SLOT_NO_COLUMN_OR_LEVEL_INVENTED"},
        "review_semantics": {"const": "EXPLICIT_SYNTHETIC_LABEL_MEMBERSHIP_NO_LEVEL_ORDER"}
      }
    },
    "permissions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "case_review_permissions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "roles": {
      "type": "array", "minItems": 6, "maxItems": 6,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["code", "name", "source_ref", "permission_review"],
        "properties": {
          "code": {"enum": ["system_admin", "data_admin", "algorithm_admin", "business_reviewer", "case_investigator", "auditor"]},
          "name": {"type": "string", "minLength": 1},
          "source_ref": {"type": "string", "minLength": 1},
          "permission_review": {
            "type": "object", "minProperties": 1,
            "additionalProperties": {"enum": ["SOURCE_RESPONSIBILITY", "SOURCE_RESTRICTION", "PENDING_CONFIRMATION"]}
          }
        }
      }
    },
    "operations": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["operation_id", "method", "path", "permission"],
        "properties": {
          "operation_id": {"type": "string", "minLength": 1},
          "method": {"enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS", "TRACE"]},
          "path": {"type": "string", "pattern": "^/"},
          "permission": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
